# Public Supabase project settings. Safe for browser use.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Optional: server-only NDAPS API integration. Never prefix secrets with NEXT_PUBLIC_.
NDAPS_API_BASE_URL=
NDAPS_API_KEY=
# Set only after confirming the official API's documented lookup path and response schema.
NDAPS_LOOKUP_PATH=
# The API's documented auth header name; defaults to Authorization.
NDAPS_AUTH_HEADER=Authorization
# For Authorization: Bearer <key>. Set "raw" if the official docs require the key without Bearer.
NDAPS_AUTH_SCHEME=Bearer
