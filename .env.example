# Public Supabase project settings. Safe for browser use.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server-only Supabase service role key (Enterprise Audit Persistence)
# Optional: used for durable, immutable server-side audit logs to public.audit_events
SUPABASE_SERVICE_ROLE_KEY=

# Optional: server-only NDAPS API integration (NIPOST National Digital Postcode).
# Never prefix secrets with NEXT_PUBLIC_.
NDAPS_API_BASE_URL=https://api.postcode.gov.ng
NDAPS_API_KEY=
NDAPS_LOOKUP_PATH=/v1/lookup
# Official NIPOST header is X-API-Key with raw key value
NDAPS_AUTH_HEADER=X-API-Key
NDAPS_AUTH_SCHEME=raw
# Primary query parameter used by NIPOST is 'code' (?code=LA010010101)
NDAPS_QUERY_PARAM=code

# Enterprise Rate Limiting & Trusted Edge Proxy Security
# Options: "none" | "cloudflare" | "vercel" | "fly" | "custom"
TRUSTED_PROXY_PROVIDER=none
TRUSTED_PROXY_HEADER=
REQUIRE_TRUSTED_PROXY=false
RATE_LIMIT_STORE_TYPE=sliding-window-tiered

# Optional: Multi-Tenant Supabase Live Probe Credentials
# Used by tests/supabase-live-probe.mjs to execute dual-tenant cross-isolation checks
TEST_USER_A_EMAIL=
TEST_USER_A_PASSWORD=
TEST_USER_B_EMAIL=
TEST_USER_B_PASSWORD=
