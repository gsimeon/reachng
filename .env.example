# Public Supabase project settings. Safe for browser use.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Optional: server-only NDAPS API integration (NIPOST National Digital Postcode).
# Never prefix secrets with NEXT_PUBLIC_.
NDAPS_API_BASE_URL=https://api.postcode.gov.ng
NDAPS_API_KEY=
NDAPS_LOOKUP_PATH=/v1/lookup
# Official NIPOST header is X-API-Key with raw key value
NDAPS_AUTH_HEADER=X-API-Key
NDAPS_AUTH_SCHEME=raw
# Primary query parameter used by NIPOST is 'code' (?code=EK-01-A03-FK-01)
NDAPS_QUERY_PARAM=code
